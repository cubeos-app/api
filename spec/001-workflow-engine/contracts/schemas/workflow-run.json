{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cubeos.app/schemas/api/workflow-run.json",
  "title": "WorkflowRun",
  "description": "One row of the workflow_runs SQLite table (CGC-verified at internal/flowengine/store.go).",
  "type": "object",
  "required": ["id", "workflow_type", "version", "current_state", "current_step", "created_at", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "workflow_type": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "external_id": {
      "type": ["string", "null"]
    },
    "input": {
      "type": ["string", "null"],
      "description": "JSON-serialised input"
    },
    "metadata": {
      "type": ["string", "null"],
      "description": "JSON-serialised metadata"
    },
    "current_state": {
      "type": "string",
      "enum": ["pending", "running", "compensating", "completed", "failed"]
    },
    "current_step": {
      "type": "integer",
      "minimum": 0
    },
    "max_retries": {
      "type": "integer",
      "minimum": 0
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "locked_by": {
      "type": ["string", "null"]
    },
    "locked_until": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "completed_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
