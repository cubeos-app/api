  "requirements": [
    {
      "id": "REQ-703",
      "body": "When a compensating action fails twice consecutively, the system shall mark the workflow_run with `requires_operator: true`."
    },
    {
      "id": "REQ-704",
      "body": "The system shall expose `GET /api/v1/workflows?requires_operator=true` returning workflow runs needing operator cleanup."
    },
    {
      "id": "REQ-705",
      "body": "The system shall expose `POST /api/v1/workflows/{id}/resolve` accepting `{notes: string}` to mark an operator-cleaned run as resolved."
    },
    {
      "id": "REQ-706",
      "body": "The system shall emit a Matrix alert when a workflow transitions to `requires_operator: true`."
    },
    {
      "id": "REQ-711",
      "body": "The system shall NOT permit more than 5 concurrent workflow instances (`CUBEOS_MAX_CONCURRENT_WORKFLOWS` env var, default 5)."
    }
  ],
